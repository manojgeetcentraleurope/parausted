{
  "name": "parausted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev --port 3001",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start --port 3001",
    "lint": "eslint",
    "test": "vitest run",
    "partner:key": "node --use-system-ca --env-file=.env.local scripts/create-partner-api-key.mjs",
    "partner:revoke": "node --use-system-ca --env-file=.env.local scripts/revoke-partner-api-key.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
