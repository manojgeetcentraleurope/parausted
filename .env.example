# ============================================================
# ParaUsted — Environment Variables
# ============================================================
# Copy this file: cp .env.example .env.local
# NEVER commit .env.local to git
# Variables with NEXT_PUBLIC_ prefix are exposed to the browser
# All others are SERVER-ONLY
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...          # ⚠️ SERVER ONLY — bypasses RLS

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx                                # ⚠️ SERVER ONLY
STRIPE_WEBHOOK_SECRET=whsec_xxx                              # ⚠️ SERVER ONLY
# For production: use pk_live_ and sk_live_ keys

# --- WhatsApp (Meta Business API) ---
WHATSAPP_API_TOKEN=xxx                                       # ⚠️ SERVER ONLY
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx                                        # ⚠️ SERVER ONLY
RESEND_FROM_EMAIL=regalos@parausted.es

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ParaUsted
NEXT_PUBLIC_APP_DOMAIN=parausted.es

# --- Sentry (Error Tracking) ---
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=xxx                                        # ⚠️ SERVER ONLY (for source maps)

# --- PostHog (Analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
